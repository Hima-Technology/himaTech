# Sanity CMS — create a free project with `npx sanity login && npx sanity init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Write token from sanity.io/manage (needed only for `npm run seed`)
SANITY_API_TOKEN=

# Resend — for the /contact-us form to actually deliver email
RESEND_API_KEY=
