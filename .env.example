# Strapi CMS — local dev: run the sibling himatech-cms project
# (npm run develop, defaults to http://localhost:1337). Fetched at
# build time only (static export) — rebuild + re-upload when content
# changes.
STRAPI_URL=http://localhost:1337
# Only needed if a content type's public read permission isn't enabled
# (see himatech-cms/src/index.ts's bootstrap — it enables this by default).
STRAPI_API_TOKEN=

# The deployed himatech-mailer function's URL (see ../himatech-mailer),
# used client-side by the contact form since this site has no server
# of its own on Hostinger.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://your-mailer-deployment.vercel.app/api/contact
